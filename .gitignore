# =========================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

*.log
*.tmp
*.temp
*.cache
*.pid
*.seed
*.bak
*.backup
*.old
*.orig
*.rej
*~

